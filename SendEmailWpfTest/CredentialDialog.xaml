<Window x:Class="SendEmailWpfTest.CredentialDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Setup SMTP Credentials" 
        Height="550" 
        Width="550"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#1E1E1E"
        Topmost="True"
        ShowInTaskbar="False">
    
    <Window.Resources>
        <SolidColorBrush x:Key="BackgroundBrush" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#2D2D30"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="TextBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#CCCCCC"/>
        <SolidColorBrush x:Key="InputBrush" Color="#3F3F46"/>
        <SolidColorBrush x:Key="InputFocusBrush" Color="#007ACC"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E639C"/>
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#1177BB"/>

        <Style x:Key="LabelStyle" TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
            <Setter Property="Padding" Value="0,0,0,8"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="{StaticResource InputBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="ButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="25,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"
                                            Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="40">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" 
                   Text="Enter SMTP Credentials" 
                   FontSize="22" 
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}"
                   Margin="0,0,0,10"/>

        <TextBlock Grid.Row="1"
                   Text="Your credentials will be stored securely using Windows DPAPI encryption."
                   FontSize="12"
                   Foreground="{StaticResource SecondaryTextBrush}"
                   TextWrapping="Wrap"
                   Margin="0,0,0,30"/>

        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <Label Content="Username" Style="{StaticResource LabelStyle}"/>
            <TextBox x:Name="txtUsername" 
                     Style="{StaticResource TextBoxStyle}"
                     Height="40"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,20">
            <Label Content="Password" Style="{StaticResource LabelStyle}"/>
            <PasswordBox x:Name="txtPassword" 
                         Style="{StaticResource PasswordBoxStyle}"
                         Height="40"/>
        </StackPanel>

        <Border Grid.Row="4"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="12"
                Margin="0,10,0,0"
                VerticalAlignment="Top"
                MaxHeight="120">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="&#xE72E;" 
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="Security Information"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="- Encrypted by Windows using DPAPI"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,3"/>
                <TextBlock Text="- Only your Windows account can access them"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           Margin="0,0,0,3"/>
                <TextBlock Text="- Never stored in configuration files"
                           FontSize="10"
                           Foreground="{StaticResource SecondaryTextBrush}"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,30,0,0">
            <Button Content="Cancel" 
                    Style="{StaticResource ButtonStyle}"
                    Background="#3F3F46"
                    Click="Cancel_Click"
                    MinWidth="100"
                    Margin="0,0,15,0"/>
            <Button Content="Save" 
                    Style="{StaticResource ButtonStyle}"
                    Click="Save_Click"
                    MinWidth="100"/>
        </StackPanel>
    </Grid>
</Window>
