<Window
    x:Class="SendEmailWinUITest.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:SendEmailWinUITest"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid x:Name="MainContentGrid" Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                <Image Source="ms-appx:///Images/email-server.png" 
                       Width="64" 
                       Height="64" 
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"/>
                <TextBlock Text="Email Sender" FontSize="32" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- SMTP Configuration Card -->
            <Border Grid.Row="1" 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- SMTP Settings Display -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="SMTP HOST" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblHostValue" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,16,0">
                            <TextBlock Text="PORT" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblPortValue" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="0,0,16,0">
                            <TextBlock Text="USERNAME" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblUsernameValue" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3">
                            <TextBlock Text="PASSWORD" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock x:Name="lblPasswordValue" FontSize="14" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>

                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="1" 
                               Orientation="Horizontal"
                               HorizontalAlignment="Right"
                               Margin="0,12,0,0"
                               Spacing="8">
                        <Button x:Name="btnDeliverability"
                                Content="Diagnostics"
                                Click="btnDeliverability_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <VisualStateManager.VisualStateGroups>
                                            <VisualStateGroup x:Name="CommonStates">
                                                <VisualState x:Name="Normal"/>
                                                <VisualState x:Name="PointerOver">
                                                    <VisualState.Setters>
                                                        <Setter Target="ButtonBackground.Background" Value="#1A9B6E"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                                <VisualState x:Name="Pressed">
                                                    <VisualState.Setters>
                                                        <Setter Target="ButtonBackground.Background" Value="#126B4C"/>
                                                    </VisualState.Setters>
                                                </VisualState>
                                            </VisualStateGroup>
                                        </VisualStateManager.VisualStateGroups>
                                        <Border x:Name="ButtonBackground" 
                                                Background="#16825D" 
                                                CornerRadius="4" 
                                                Padding="12,6">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <Button x:Name="btnSettings"
                                Click="btnSettings_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon Glyph="&#xE713;" FontSize="14"/>
                                <TextBlock Text="Settings"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Email Compose Section -->
            <Grid Grid.Row="2" 
                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                  BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                  BorderThickness="1"
                  CornerRadius="8"
                  Padding="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="Compose Email" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/>

                <!-- To Email -->
                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                    <TextBlock Text="To" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtToEmail" PlaceholderText="recipient@example.com"/>
                </StackPanel>

                <!-- Subject -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <TextBlock Text="Subject" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtSubject" PlaceholderText="Enter subject"/>
                </StackPanel>

                <!-- Body -->
                <StackPanel Grid.Row="3" Margin="0,0,0,12">
                    <TextBlock Text="Body" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtBody" 
                             PlaceholderText="Enter email body"
                             AcceptsReturn="True" 
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MinHeight="300"
                             Height="350"/>
                </StackPanel>

                <!-- HTML Checkbox -->
                <CheckBox Grid.Row="4" 
                          x:Name="chkIsHtml" 
                          Content="Send as HTML"/>
            </Grid>

            <!-- Action Buttons -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="btnClose" 
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Click="btnClose_Click"
                        MinWidth="140"
                        Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE711;" FontSize="16"/>
                        <TextBlock Text="Close"/>
                    </StackPanel>
                </Button>

                <Button x:Name="btnSend" 
                        Grid.Column="1"
                        Style="{StaticResource AccentButtonStyle}"
                        Click="btnSend_Click"
                        MinWidth="140">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE122;" FontSize="16"/>
                        <TextBlock Text="Send Email"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <!-- Blur Overlay -->
        <Grid x:Name="BlurOverlay" 
              Background="#80000000" 
              Visibility="Collapsed"/>
    </Grid>
</Window>